normNorm_Bayesian = function(mu, sigma, mu0, tau, n) {

	smpl = rnorm(n, mu, sigma);
	smplMean = mean(smpl)
	print(paste("the mean is = ", smplMean))
	postVar = 1/(n/(sigma^2) + 1/(tau^2))
	postMean = postVar*(smplMean/(sigma^2/n) + mu0/(tau^2))
	
	xlimits = seq(-5,5,.01)
	prior = dnorm(xlimits, mu0, tau);



	post = dnorm(xlimits, postMean, sqrt(postVar))
	plot(xlimits, prior, type = "l", ylim = c(0, max(post)))
	lines(xlimits, post, type = "l", col = "red")
	
}


betaBinom_Bayesian = function(n, p, alpha, beta) {

	smpl = rbinom(1, n, p);
	print(paste("number of successes = ", smpl))
	xlimits = seq(0,1,.01);
	prior = dbeta(xlimits, alpha, beta);
	post_alpha = alpha + smpl;
	post_beta = beta + n - smpl;
	post = dbeta(xlimits, post_alpha, post_beta);
	plot(xlimits, prior, type = "l", ylim = c(0, max(post)))
	lines(xlimits, post, type = "l", col = "red")
}