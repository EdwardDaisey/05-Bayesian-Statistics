# ############################## Main Function #################################
#    Name: Main
# Purpose: Runs Problems 5, 6, and 7 in order.
#
# Explanation:
#   Main is the entry point of the program.
#
#   It:
#
#       (1) Creates the random number generator.
#       (2) Runs Problem 5.
#       (3) Runs Problem 6.
#       (4) Runs Problem 7.
#       (5) Returns all three sets of simulated values.
#
#  Input:  None.  The constants above control the simulation.
#
# Output:  problem5Samples - simulated values from Problem 5.
#          problem6Samples - simulated values from Problem 6.
#          problem7Samples - simulated values from Problem 7.
def Main():
    randomGenerator = CreateRandomGenerator(seedValue)

    problem5Samples = RunProblem5(randomGenerator)
    problem6Samples = RunProblem6(randomGenerator)
    problem7Samples = RunProblem7(randomGenerator)

    return problem5Samples, problem6Samples, problem7Samples


problem5Samples, problem6Samples, problem7Samples = Main()
# ##############################################################################
