# ############################## Function 1 ####################################
#    Name: SimulateDoubleTruncatedExponential
# Purpose: Simulates observations from the double-truncated-exponential
#          distribution using the Accept-Reject algorithm.
#
# Explanation:
#   The target distribution is proportional to:
#
#       (alpha / 2) * exp(-alpha * abs(x))
#
#   on the interval:
#
#       -gamma < x < gamma
#
#   In this assignment:
#
#       alpha = 1
#       gamma = 4
#
#   So the proposal distribution is:
#
#       Uniform(-4, 4)
#
#   The Accept-Reject method works as follows:
#
#       (1) Propose a value from Uniform(-4, 4).
#       (2) Generate another random value from Uniform(0, 1).
#       (3) Accept the proposed value if the uniform value is less than or
#           equal to exp(-alpha * abs(proposedValue)).
#       (4) If the value is rejected, throw it away and try again.
#       (5) Continue until 10,000 values have been accepted.
#
#   The value totalProposalCount is tracked so that we can calculate the
#   acceptance rate:
#
#       acceptance rate = accepted values / total proposed values
#
#  Input:  numSamples - number of accepted observations required.
#          alphaValue - alpha parameter.
#          gammaValue - gamma truncation parameter.
#          randomGenerator - Mersenne Twister random number generator.
#
# Output:  acceptedArray - accepted simulated observations.
#          totalProposalCount - total number of proposed values.
def SimulateDoubleTruncatedExponential(
    numSamples,
    alphaValue,
    gammaValue,
    randomGenerator
):
    acceptedValues = []
    totalProposalCount = 0

    while len(acceptedValues) < numSamples:
        proposedValue = randomGenerator.uniform(-gammaValue, gammaValue)
        uniformValue = randomGenerator.uniform(0, 1)

        acceptanceProbabilityValue = np.exp(
            -alphaValue * np.abs(proposedValue)
        )

        totalProposalCount += 1

        if uniformValue <= acceptanceProbabilityValue:
            acceptedValues.append(proposedValue)

    acceptedArray = np.array(acceptedValues)

    return acceptedArray, totalProposalCount
# ##############################################################################


# ############################## Function 2 ####################################
#    Name: CalculateDoubleTruncatedDensity
# Purpose: Calculates the normalized double-truncated-exponential density.
#
# Explanation:
#   The assignment gives the density up to proportionality:
#
#       f(x | alpha, gamma) proportional to
#       (alpha / 2) * exp(-alpha * abs(x))
#
#   on:
#
#       -gamma < x < gamma
#
#   To plot the theoretical density, we need the normalized density.
#
#   The normalizing constant is:
#
#       1 - exp(-alpha * gamma)
#
#   Therefore, the normalized density is:
#
#       f(x | alpha, gamma)
#       = [(alpha / 2) * exp(-alpha * abs(x))] / [1 - exp(-alpha * gamma)]
#
#  Input:  xValues - grid of x values.
#          alphaValue - alpha parameter.
#          gammaValue - gamma truncation parameter.
#
# Output:  densityValues - theoretical density values.
def CalculateDoubleTruncatedDensity(xValues, alphaValue, gammaValue):
    normalizingConstant = 1 - np.exp(-alphaValue * gammaValue)

    densityValues = np.where(
        np.abs(xValues) < gammaValue,
        ((alphaValue / 2) * np.exp(-alphaValue * np.abs(xValues))) / normalizingConstant,
        0
    )

    return densityValues
# ##############################################################################


# ############################## Function 3 ####################################
#    Name: PlotProblem7Histogram
# Purpose: Creates a histogram of the simulated double-truncated-exponential
#          values from Problem 7.
#
# Explanation:
#   The histogram shows the simulated density of the accepted values.
#
#   The theoretical density is also plotted on top of the histogram.  This makes
#   it easier to visually check whether the Accept-Reject algorithm generated
#   values from the correct distribution.
#
#  Input:  problem7Samples - simulated values from Problem 7.
#
# Output:  Histogram displayed and saved as problem7Histogram.png.
def PlotProblem7Histogram(problem7Samples):
    xGridValues = np.linspace(-gammaValue, gammaValue, 500)

    densityValues = CalculateDoubleTruncatedDensity(
        xGridValues,
        alphaValue,
        gammaValue
    )

    plt.figure(figsize = (7, 4.5))
    plt.hist(problem7Samples, bins = 60, density = True, rwidth = 0.9, label = "Simulated Density")
    plt.plot(xGridValues, densityValues, linewidth = 2, label = "Theoretical Density")
    plt.title("Problem 7: Histogram of Simulated Double-Truncated-Exponential Values")
    plt.xlabel("X")
    plt.ylabel("Density")
    plt.legend()
    plt.tight_layout()
    plt.savefig("problem7Histogram.png")
    plt.show()
# ##############################################################################


# ############################## Function 4 ####################################
#    Name: RunProblem7
# Purpose: Runs all steps for Problem 7.
#
# Explanation:
#   This function:
#
#       (1) Simulates 10,000 accepted observations.
#       (2) Tracks how many total proposed values were needed.
#       (3) Calculates the acceptance rate.
#       (4) Prints summary statistics for the simulated data.
#       (5) Creates a histogram with the theoretical density overlaid.
#
#  Input:  randomGenerator - Mersenne Twister random number generator.
#
# Output:  problem7Samples - simulated double-truncated-exponential values.
def RunProblem7(randomGenerator):
    print("\n" + "#" * 78)
    print("PROBLEM 7: Accept-Reject Simulation for Double-Truncated-Exponential")
    print("#" * 78)

    problem7Samples, totalProposalCount = SimulateDoubleTruncatedExponential(
        numSimulations,
        alphaValue,
        gammaValue,
        randomGenerator
    )

    acceptanceRate = numSimulations / totalProposalCount

    print("\nSimulation Summary")
    print("-" * 78)
    print(f"{'Number of Accepted Observations':<35} {numSimulations:>15}")
    print(f"{'Total Proposals Generated':<35} {totalProposalCount:>15}")
    print(f"{'Acceptance Rate':<35} {acceptanceRate:>15.4f}")
    print(f"{'First 10 Values':<35} {str(problem7Samples[:10]):>15}")
    print(f"{'Simulated Mean':<35} {np.mean(problem7Samples):>15.4f}")
    print(f"{'Simulated Standard Deviation':<35} {np.std(problem7Samples, ddof = 1):>15.4f}")
    print(f"{'Minimum Simulated Value':<35} {np.min(problem7Samples):>15.4f}")
    print(f"{'Maximum Simulated Value':<35} {np.max(problem7Samples):>15.4f}")

    PlotProblem7Histogram(problem7Samples)

    return problem7Samples
# ##############################################################################


# ##############################################################################
# ################################### MAIN #####################################
