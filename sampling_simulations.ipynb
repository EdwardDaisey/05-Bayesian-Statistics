# =============================================================================
# Dependencies
# =============================================================================
import numpy as np
import matplotlib.pyplot as plt
from math import comb
# =============================================================================


# =============================================================================
# Constants
# =============================================================================
# The assignment asks for 10,000 simulated values in each problem.
numSimulations = 10000

# The seed makes the simulation reproducible when used with Mersenne Twister!
# Changing this number changes the random sample, but not the underlying method.
# Dr. Dave Ackley has some good videos on the Mersenne Twister algorithm.
seedValue = 10000

# Constants for Problem 5.
numFlips = 3
headProbability = 0.7

# Constants for Problem 7.
alphaValue = 1.0
gammaValue = 4.0
# =============================================================================


# =============================================================================
# Random Number Generator
# =============================================================================
#    Name: CreateRandomGenerator
# Purpose: Creates a Mersenne Twister random number generator.
#
# Explanation:
#   The Mersenne Twister algorithm is used explicitly through np.random.MT19937.
#   The seedValue makes the simulation reproducible.  This means that if the
#   same seedValue is used again, the same simulated values will be produced.
#
#  Input:  seedValue - the seed used for reproducibility.
#
# Output:  randomGenerator - a NumPy random number generator using MT19937.
def CreateRandomGenerator(seedValue):
    randomGenerator = np.random.Generator(np.random.MT19937(seedValue))
    return randomGenerator
# =============================================================================


# ##############################################################################
# ################################# PROBLEM 5 ##################################
# ##############################################################################


# ############################## Function 1 ####################################
#    Name: CalculateCoinProbabilities
# Purpose: Calculates the probability values and cumulative probability values
#          for X = number of heads in three coin flips.
#
# Explanation:
#   Since X is the number of heads in three flips, X follows a binomial
#   distribution with:
#
#       n = 3
#       p = 0.7
#
#   The binomial probability formula is:
#
#       P(X = x) = C(n, x) * p^x * (1 - p)^(n - x)
#
#   In this problem:
#
#       n = 3
#       p = 0.7
#       1 - p = 0.3
#
#   Therefore:
#
#       P(X = x) = C(3, x) * (0.7)^x * (0.3)^(3 - x)
#
#   The possible values of X are:
#
#       0, 1, 2, 3
#
#   After calculating the probability values, this function also calculates the
#   cumulative probability values.  These cumulative probabilities are used as
#   cutoffs in the inverse-transform method.
#
#  Input:  numFlips - number of coin flips.
#          headProbability - probability of heads on each flip.
#
# Output:  outcomeValues - possible values of X.
#          probabilityValues - P(X = x) values.
#          cumulativeProbabilityValues - F(x) values.
def CalculateCoinProbabilities(numFlips, headProbability):
    outcomeValues = np.arange(numFlips + 1)

    probabilityValues = np.array([
        comb(numFlips, outcomeValue)
        * (headProbability ** outcomeValue)
        * ((1 - headProbability) ** (numFlips - outcomeValue))
        for outcomeValue in outcomeValues
    ])

    cumulativeProbabilityValues = np.cumsum(probabilityValues)

    return outcomeValues, probabilityValues, cumulativeProbabilityValues
# ##############################################################################


# ############################## Function 2 ####################################
#    Name: SimulateCoinInverseTransform
# Purpose: Simulates values of X using the inverse-transform method.
#
# Explanation:
#   The inverse-transform method works by generating values from Uniform(0, 1)
#   and then mapping each uniform value to an outcome using the CDF.
#
#   For this problem, the CDF cutoffs are:
#
#       F(0) = 0.027
#       F(1) = 0.216
#       F(2) = 0.657
#       F(3) = 1.000
#
#   Therefore:
#
#       If 0.000 < u <= 0.027, then X = 0.
#       If 0.027 < u <= 0.216, then X = 1.
#       If 0.216 < u <= 0.657, then X = 2.
#       If 0.657 < u <= 1.000, then X = 3.
#
#   np.searchsorted finds the first CDF cutoff that is greater than or equal to
#   the uniform value.  That index corresponds to the simulated value of X.
#
#  Input:  numSamples - number of values to simulate.
#          outcomeValues - possible values of X.
#          cumulativeProbabilityValues - CDF cutoff values.
#          randomGenerator - Mersenne Twister random number generator.
#
# Output:  simulatedValues - simulated values of X.
def SimulateCoinInverseTransform(numSamples, outcomeValues, cumulativeProbabilityValues, randomGenerator):
    uniformValues = randomGenerator.uniform(0, 1, numSamples)

    cutoffIndexValues = np.searchsorted(
        cumulativeProbabilityValues,
        uniformValues,
        side = "left"
    )

    simulatedValues = outcomeValues[cutoffIndexValues]

    return simulatedValues
# ##############################################################################


# ############################## Function 3 ####################################
#    Name: PlotProblem5Histogram
# Purpose: Creates the required histogram for Problem 5.
#
# Explanation:
#   The histogram shows how often each simulated value of X occurred.
#
#   Since X can only be 0, 1, 2, or 3, the bins are centered around those values.
#   The bin edges are:
#
#       -0.5, 0.5, 1.5, 2.5, 3.5
#
#   This makes the bars line up cleanly with 0, 1, 2, and 3.
#
#  Input:  problem5Samples - simulated values from Problem 5.
#
# Output:  Histogram displayed and saved as problem5Histogram.png.
def PlotProblem5Histogram(problem5Samples):
    binEdges = np.arange(-0.5, 4.5, 1)

    plt.figure(figsize = (7, 4.5))
    plt.hist(problem5Samples, bins = binEdges, rwidth = 0.8)
    plt.title("Problem 5: Histogram of Simulated Coin Flips")
    plt.xlabel("Number of Heads, X")
    plt.ylabel("Frequency")
    plt.xticks([0, 1, 2, 3])
    plt.tight_layout()
    plt.savefig("problem5Histogram.png")
    plt.show()
# ##############################################################################


# ############################## Function 4 ####################################
#    Name: RunProblem5
# Purpose: Runs all steps for Problem 5.
#
# Explanation:
#   This function:
#
#       (1) Calculates the theoretical PMF values.
#       (2) Calculates the CDF values used for inverse-transform sampling.
#       (3) Simulates 10,000 values of X.
#       (4) Prints the theoretical and simulated results.
#       (5) Creates the required histogram.
#
#  Input:  randomGenerator - Mersenne Twister random number generator.
#
# Output:  problem5Samples - simulated values from Problem 5.
def RunProblem5(randomGenerator):
    print("\n" + "#" * 78)
    print("PROBLEM 5: Inverse-Transform Simulation for X")
    print("#" * 78)

    outcomeValues, probabilityValues, cumulativeProbabilityValues = (
        CalculateCoinProbabilities(numFlips, headProbability)
    )

    problem5Samples = SimulateCoinInverseTransform(
        numSimulations,
        outcomeValues,
        cumulativeProbabilityValues,
        randomGenerator
    )

    simulatedFrequencyValues = np.bincount(
        problem5Samples,
        minlength = len(outcomeValues)
    )

    print("\nTheoretical PMF and CDF Values")
    print("-" * 78)
    print(f"{'x':>5} {'P(X = x)':>15} {'F(x)':>15}")
    print("-" * 78)

    for outcomeValue, probabilityValue, cumulativeProbabilityValue in zip(
        outcomeValues,
        probabilityValues,
        cumulativeProbabilityValues
    ):
        print(
            f"{outcomeValue:>5}"
            f"{probabilityValue:>15.3f}"
            f"{cumulativeProbabilityValue:>15.3f}"
        )

    print("\nSimulated Frequencies")
    print("-" * 78)
    print(f"{'x':>5} {'Frequency':>15} {'Relative Frequency':>22}")
    print("-" * 78)

    for outcomeValue, frequencyValue in zip(outcomeValues, simulatedFrequencyValues):
        relativeFrequencyValue = frequencyValue / numSimulations
        print(
            f"{outcomeValue:>5}"
            f"{frequencyValue:>15}"
            f"{relativeFrequencyValue:>22.4f}"
        )

    PlotProblem5Histogram(problem5Samples)

    return problem5Samples
# ##############################################################################


# ##############################################################################
# ################################# PROBLEM 6 ##################################
# ##############################################################################


# ############################## Function 1 ####################################
#    Name: SimulateThetaInverseTransform
# Purpose: Simulates theta values from the density:
#
#              p(theta | x) = (1 + 0.5 * theta) / 2
#
#          on the interval:
#
#              -1 <= theta <= 1
#
# Explanation:
#   The CDF is:
#
#       F(theta) = theta / 2 + theta^2 / 8 + 3 / 8
#
#   The inverse-CDF equation is:
#
#       theta = -2 + sqrt(1 + 8u)
#
#   Therefore, the simulation procedure is:
#
#       (1) Generate u from Uniform(0, 1).
#       (2) Compute theta = -2 + sqrt(1 + 8u).
#       (3) Repeat this 10,000 times.
#
#  Input:  numSamples - number of theta values to simulate.
#          randomGenerator - Mersenne Twister random number generator.
#
# Output:  thetaValues - simulated theta values.
def SimulateThetaInverseTransform(numSamples, randomGenerator):
    uniformValues = randomGenerator.uniform(0, 1, numSamples)
    thetaValues = -2 + np.sqrt(1 + 8 * uniformValues)

    return thetaValues
# ##############################################################################


# ############################## Function 2 ####################################
#    Name: PlotProblem6Histogram
# Purpose: Creates a histogram of the simulated theta values from Problem 6.
#
# Explanation:
#   The histogram shows the simulated density of theta values.
#
#   Since the theoretical density is:
#
#       p(theta | x) = (1 + 0.5 * theta) / 2
#
#   the theoretical density is also plotted on top of the histogram.
#
#   This allows us to visually check whether the inverse-transform simulation
#   generated values from the correct distribution.
#
#  Input:  problem6Samples - simulated theta values from Problem 6.
#
# Output:  Histogram displayed and saved as problem6Histogram.png.
def PlotProblem6Histogram(problem6Samples):
    thetaGridValues = np.linspace(-1, 1, 300)
    densityValues = (1 + 0.5 * thetaGridValues) / 2

    plt.figure(figsize = (7, 4.5))
    plt.hist(problem6Samples, bins = 50, density = True, rwidth = 0.9, label = "Simulated Density")
    plt.plot(thetaGridValues, densityValues, linewidth = 2, label = "Theoretical Density")
    plt.title("Problem 6: Histogram of Simulated Theta Values")
    plt.xlabel("Theta")
    plt.ylabel("Density")
    plt.legend()
    plt.tight_layout()
    plt.savefig("problem6Histogram.png")
    plt.show()
# #############################################################################


# ############################## Function 3 ####################################
#    Name: RunProblem6
# Purpose: Runs all steps for Problem 6.
#
# Explanation:
#   This function:
#
#       (1) Simulates 10,000 theta values.
#       (2) Prints the first 10 simulated values.
#       (3) Prints summary statistics so the output can be checked.
#       (4) Creates a histogram with the theoretical density overlaid.
#
#  Input:  randomGenerator - Mersenne Twister random number generator.
#
# Output:  problem6Samples - simulated theta values.
def RunProblem6(randomGenerator):
    print("\n" + "#" * 78)
    print("PROBLEM 6: Inverse-Transform Simulation for Theta")
    print("#" * 78)

    problem6Samples = SimulateThetaInverseTransform(
        numSimulations,
        randomGenerator
    )

    print("\nSimulation Summary")
    print("-" * 78)
    print(f"{'Number of Simulations':<30} {numSimulations:>15}")
    print(f"{'First 10 Values':<30} {str(problem6Samples[:10]):>15}")
    print(f"{'Simulated Mean':<30} {np.mean(problem6Samples):>15.4f}")
    print(f"{'Simulated Standard Deviation':<30} {np.std(problem6Samples, ddof = 1):>15.4f}")
    print(f"{'Minimum Simulated Value':<30} {np.min(problem6Samples):>15.4f}")
    print(f"{'Maximum Simulated Value':<30} {np.max(problem6Samples):>15.4f}")

    PlotProblem6Histogram(problem6Samples)

    return problem6Samples
# #############################################################################


